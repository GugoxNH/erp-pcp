NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Set to your canonical HTTPS domain when deploying.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Gmail per user: server-only values. See docs/gmail-perfil.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:3000/api/gmail/callback
# 32 random bytes encoded as 64 hexadecimal characters. Keep stable and private.
GMAIL_TOKEN_ENCRYPTION_KEY=
